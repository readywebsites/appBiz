# Biz499 Backend Environment Configuration

# General
DEBUG=True
SECRET_KEY=biz499-dev-insecure-secret-key-change-in-production-min-50-chars-random
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL with SQLite fallback if DB_NAME is empty)
# Set DB_NAME to use PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006

# JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14

# Payment Gateway (Razorpay Sandbox/Live)
RAZORPAY_KEY_ID=rzp_test_biz499sandboxkey
RAZORPAY_KEY_SECRET=biz499sandboxsecretkey
RAZORPAY_WEBHOOK_SECRET=biz499sandboxwebhooksecret

# Business Profile & Financials
COMPANY_NAME=Biz499 Digital Services
COMPANY_EMAIL=support@biz499.com
COMPANY_PHONE=+91 98765 43210
COMPANY_GSTIN=27ABCDE1234F1Z5
COMPANY_ADDRESS=Biz499 Tech Park, High Street, Mumbai, Maharashtra 400001
TAX_PERCENTAGE=18.0
DEFAULT_CURRENCY=INR

# SMS Provider Configuration (Phone OTP)
# Set to "TWILIO" for production SMS, or leave as "DEV" for local development terminal simulation
SMS_PROVIDER=DEV
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_placeholder
TWILIO_AUTH_TOKEN=your_twilio_auth_token_placeholder
TWILIO_VERIFY_SERVICE_SID=VA_your_verify_service_sid_placeholder
TWILIO_PHONE_NUMBER=+1234567890

# Email Delivery Configuration (Email OTP & Account Notifications)
# In development, leave empty to use console email backend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_biz499_email@gmail.com
EMAIL_HOST_PASSWORD=your_google_app_password_16_chars
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Biz499 Security <no-reply@biz499.com>

# OTP Challenge Security Settings
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_ATTEMPTS=5


